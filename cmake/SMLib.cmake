# Build only the unmodified upstream kernel and SM_API: no USD, Python, TBB or GUI.
set(SMLIB_ROOT "${PROJECT_SOURCE_DIR}/third_party/usd-brep" CACHE PATH "Pinned usd-brep checkout")
if(NOT EXISTS "${SMLIB_ROOT}/source/SMLib/src/SmBrep.cpp")
  message(FATAL_ERROR "Run git submodule update --init --recursive")
endif()
file(GLOB kernel_sources CONFIGURE_DEPENDS "${SMLIB_ROOT}/source/SMLib/src/*.cpp")
file(GLOB api_sources CONFIGURE_DEPENDS "${SMLIB_ROOT}/source/SM_API/src/*.cpp")
add_library(smlib STATIC ${kernel_sources})
target_include_directories(smlib SYSTEM PUBLIC "${SMLIB_ROOT}/source/SMLib/inc")
target_compile_definitions(smlib PUBLIC NOMINMAX SM_GRAPHICS_CALLBACKS=1)
add_library(sm_api STATIC ${api_sources})
target_include_directories(sm_api SYSTEM PUBLIC "${SMLIB_ROOT}/source/SM_API/inc")
target_compile_definitions(sm_api PUBLIC SM_API_EXPORTS)
target_link_libraries(sm_api PUBLIC smlib)
if(MSVC)
  target_compile_options(smlib PRIVATE /utf-8 /bigobj)
  target_compile_options(sm_api PRIVATE /utf-8 /bigobj)
else()
  target_compile_options(smlib PRIVATE -w)
  target_compile_options(sm_api PRIVATE -w)
endif()
