    "revision_conflict",
    "invalid_reference",
    "history_unavailable",
    "validation_failed",
    "kernel_error",
    "io_error",
    "internal_error",
    "version_mismatch",
    "wrong_instance",
    "wrong_session",
    "client_not_initialized",
    "request_conflict",
    "outcome_unavailable",
    "outcome_unknown",
    "client_limit"
