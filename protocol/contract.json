{
  "protocol_version": "1.0",
  "schema_subset": "AI-CAD structural subset of JSON Schema 2020-12; integer is an integer JSON token; numbers must be finite; identifier is ASCII alphanumeric or ._:-",
  "$defs": {
    "Counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "format": "identifier"
    },
    "Point3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "const": "command_failed"
        },
        "kind": {
          "type": "string",
          "enum": [
            "invalid_request",
            "invalid_params",
            "unknown_command",
            "document_not_found",
            "empty_document",
            "revision_conflict",
            "invalid_reference",
            "history_unavailable",
            "validation_failed",
            "kernel_error",
            "io_error",
            "internal_error",
            "version_mismatch",
            "wrong_instance",
            "wrong_session",
            "client_not_initialized",
            "request_conflict",
            "outcome_unavailable",
            "outcome_unknown",
            "client_limit"
          ]
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "kind",
        "message"
      ],
      "additionalProperties": false
    },
    "State": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "units": {
          "const": "mm"
        },
        "empty": {
          "type": "boolean"
        },
        "volume": {
          "type": "number"
        },
        "faces": {
          "$ref": "#/$defs/Counter"
        },
        "edges": {
          "$ref": "#/$defs/Counter"
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "units",
        "empty"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "empty": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "empty": {
              "const": false
            }
          },
          "required": [
            "volume",
            "faces",
            "edges",
            "valid"
          ]
        }
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "kernel": {
          "const": "smlib"
        },
        "gpu_picking": {
          "type": "boolean"
        },
        "persistent_naming": {
          "type": "boolean"
        },
        "native_format": {
          "const": "smb"
        }
      },
      "required": [
        "kernel",
        "gpu_picking",
        "persistent_naming",
        "native_format"
      ],
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point3"
          }
        },
        "length": {
          "type": "number"
        }
      },
      "required": [
        "reference",
        "points",
        "length"
      ],
      "additionalProperties": false
    },
    "Triangle": {
      "type": "object",
      "properties": {
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Counter"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "face": {
          "type": "string"
        }
      },
      "required": [
        "vertices",
        "face"
      ],
      "additionalProperties": false
    },
    "Mesh": {
      "type": "object",
      "properties": {
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point3"
          }
        },
        "triangles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Triangle"
          }
        }
      },
      "required": [
        "points",
        "triangles"
      ],
      "additionalProperties": false
    },
    "Request": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protocol": {
              "type": "string"
            },
            "request_id": {
              "type": "integer",
              "const": 0
            },
            "client_id": {
              "$ref": "#/$defs/Identifier"
            },
            "method": {
              "const": "hello"
            }
          },
          "required": [
            "protocol",
            "request_id",
            "client_id",
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "type": "string"
            },
            "request_id": {
              "$ref": "#/$defs/Counter"
            },
            "client_id": {
              "$ref": "#/$defs/Identifier"
            },
            "method": {
              "const": "execute"
            },
            "worker_id": {
              "$ref": "#/$defs/Identifier"
            },
            "session_id": {
              "$ref": "#/$defs/Identifier"
            },
            "command": {
              "type": "object"
            }
          },
          "required": [
            "protocol",
            "request_id",
            "client_id",
            "method",
            "worker_id",
            "session_id",
            "command"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "type": "string"
            },
            "request_id": {
              "$ref": "#/$defs/Counter"
            },
            "client_id": {
              "$ref": "#/$defs/Identifier"
            },
            "method": {
              "const": "request.status"
            },
            "worker_id": {
              "$ref": "#/$defs/Identifier"
            },
            "session_id": {
              "$ref": "#/$defs/Identifier"
            },
            "target_request_id": {
              "$ref": "#/$defs/Counter"
            }
          },
          "required": [
            "protocol",
            "request_id",
            "client_id",
            "method",
            "worker_id",
            "session_id",
            "target_request_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Event": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "document.created",
            "document.changed"
          ]
        },
        "event_id": {
          "$ref": "#/$defs/Counter"
        },
        "worker_id": {
          "$ref": "#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "document": {
          "$ref": "#/$defs/Identifier"
        },
        "revision": {
          "$ref": "#/$defs/Counter"
        },
        "client_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_id": {
          "$ref": "#/$defs/Counter"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "event_id",
        "worker_id",
        "session_id",
        "document",
        "revision",
        "client_id",
        "request_id",
        "command"
      ],
      "additionalProperties": false
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "1.0"
            },
            "request_id": {
              "$ref": "#/$defs/Counter"
            },
            "client_id": {
              "$ref": "#/$defs/Identifier"
            },
            "worker_id": {
              "$ref": "#/$defs/Identifier"
            },
            "session_id": {
              "$ref": "#/$defs/Identifier"
            },
            "service_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Identifier"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ok": {
              "const": true
            },
            "result": {},
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Event"
              }
            },
            "replayed": {
              "type": "boolean"
            }
          },
          "required": [
            "protocol",
            "request_id",
            "client_id",
            "worker_id",
            "session_id",
            "service_id",
            "ok",
            "result",
            "events",
            "replayed"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "1.0"
            },
            "request_id": {
              "$ref": "#/$defs/Counter"
            },
            "client_id": {
              "$ref": "#/$defs/Identifier"
            },
            "worker_id": {
              "$ref": "#/$defs/Identifier"
            },
            "session_id": {
              "$ref": "#/$defs/Identifier"
            },
            "service_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Identifier"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/Error"
            },
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Event"
              }
            },
            "replayed": {
              "type": "boolean"
            }
          },
          "required": [
            "protocol",
            "request_id",
            "client_id",
            "worker_id",
            "session_id",
            "service_id",
            "ok",
            "error",
            "events",
            "replayed"
          ],
          "additionalProperties": false
        }
      ]
    },
    "HelloResult": {
      "type": "object",
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/Capabilities"
