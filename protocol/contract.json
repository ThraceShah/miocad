            },
            "max_bytes": {
              "$ref": "#/$defs/Counter"
            },
            "durable": {
              "const": false
            }
          },
          "required": [
            "scope",
            "max_entries",
            "max_bytes",
            "durable"
          ],
          "additionalProperties": false
        },
        "mesh_transport": {
          "const": "json.inline"
        },
        "events": {
          "const": "inline"
        },
        "shared_service": {
          "const": false
        },
        "last_request_id": {
          "$ref": "#/$defs/Counter"
        }
      },
      "required": [
        "capabilities",
        "deduplication",
        "mesh_transport",
        "events",
        "shared_service",
        "last_request_id"
      ],
      "additionalProperties": false
    },
    "StatusResult": {
      "oneOf": [
